{
	"layer": "top",
	"position": "top",
	"height": 50,
	"spacing": 4,

	"margin-top": 4,
	"margin-right": 20,
	"margin-left": 20,
	"margin-bottom": 0,

	"modules-left": ["custom/sep", "custom/sep", "custom/arch", "custom/sep", "custom/sep", "custom/updates", "custom/sep", "custom/sep", "custom/nightmode", "custom/sep", "tray", "custom/sep", "custom/sep", "memory", "custom/sep", "cpu", "custom/sep", "custom/gpu"],
	"modules-center": ["hyprland/workspaces"],
	"modules-right": ["network", "custom/sep", "custom/keyboard", "pulseaudio#microphone", "pulseaudio", "custom/sep", "clock", "custom/sep", "custom/notification", "custom/sep", "custom/power", "custom/sep", "custom/sep", "custom/sep"],

	"custom/sep": {
		"format": " "
	},

	"custom/keyboard": {
		"format": "<span color='#5A2EFF'>󰌌</span> {}",
		"exec": "~/.config/waybar/scripts/keyboard.sh",
		"return-type": "json",
		"interval": 1
	},

	"pulseaudio#microphone": {
    		"format": "{format_source}",
    		"format-source": " <span color='#5A2EFF'>󰍬</span> ",
    		"format-source-muted": " <span color='#5A2EFF'>󰍭</span> ",
    		"on-click": "pamixer --default-source -t",
    		"on-click-right": "pavucontrol",
    		"tooltip": false
  	},

	"memory": {
		"format": "<span color='#5A2EFF'></span> {percentage}%",
        	"format-alt": "<span color='#5A2EFF'></span> {used:0.1f}G/{total:0.1f}G",
		"interval": 3
	},

	"cpu": {
		"format": "<span color='#5A2EFF'></span> {usage}%",
        	"format-alt": "<span color='#5A2EFF'></span> {avg_frequency} GHz",
		"interval": 3
	},

	
	"custom/power": {
		"format": " ",
		"on-click": "wlogout"
	},

	"custom/gpu": {
		"format": "<span color='#5A2EFF'>󰍹</span> {}° ",
		"return-type": "json",
		"exec": "~/.config/waybar/scripts/gpu.sh",
		"interval": 5
	},

	"custom/arch": {
		"format": " 󰣇 ",
		"on-click": "killall waybar && waybar &"
	},

	"tray": {
    		"icon-size": 18,
    		"spacing": 12 
	},

	"custom/notification": {
    		"tooltip": false,
    		"format": " {icon} ",
    		"format-icons": {
      			"notification": "󰅸",
      			"none": "󰂜",
      			"dnd-notification": "󰅸",
      			"dnd-none": "󱏨",
      			"inhibited-notification": "󰅸",
      			"inhibited-none": "󰂜",
      			"dnd-inhibited-notification": "󰅸",
      			"dnd-inhibited-none": "󱏨"
    		},
    		"return-type": "json",
    		"exec-if": "which swaync-client",
    		"exec": "swaync-client -swb",
    		"on-click-right": "swaync-client -d -sw",
    		"on-click": "swaync-client -t -sw",
    		"escape": true
  	},

	"hyprland/workspaces": {
		"disable-scroll": true,
    		"all-outputs": true,
    		"format": "{icon}",
		"format-icons": {
			"default": "",
			"active": ""
		},
		"persistent-workspaces": {
			"*": 9
		}
	},

	"custom/updates": {
		"format": " {}",
		"exec": "checkupdates | wc -l"
	},

	"clock": {
		"format": "󰥔 {:%I:%M %p}",
		"format-alt": "{:%A, %d %B %Y}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"mode"          : "month",
			"mode-mon-col"  : 3,
			"weeks-pos"     : "right",
			"on-scroll"     : 1,
			"on-click-right": "mode",
			"format": {
				"months": "<span color='#ffd86e'><b>{}</b></span>",
				"days": "<span color='#e6e6e6'><b>{}</b></span>",
				"weeks": "<span color='#9ece6a'><b>W{}</b></span>",
				"weekdays": "<span color='#7dcfff'><b>{}</b></span>",
				"today": "<span color='#ff9e64'><b><u>{}</u></b></span>"
			}
		},
		"actions": {
			"on-click-right": "mode",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	},

	"cava": {
      		"framerate": 60,
      		//"autosens": 1,
      		"bars": 14,
		"method": "pipewire",
     		"lower_cutoff_freq": 50,
      		"higher_cutoff_freq": 10000,
      		"source": "auto",
      		"stereo": true,
      		"reverse": false,
      		"bar_delimiter": 0,
      		"monstercat": false,
      		"waves": false,
      		"noise_reduction": 0.77,
      		"input_delay": 4,
		"sleep_timer": 5,
      		"format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
      		"actions": {
                 	"on-click-right": "mode"
                 }
    	},

	"pulseaudio": {
		"format": "<span color='#5A2EFF'>{icon}</span> {volume}% ",
		"format-muted": "<span color='#5A2EFF'></span>  ",
		"format-source": " {volume}%",
		"format-source-muted": "",
		"format-bluetooth": "󰂰 {volume}%",
		"format-bluetooth-muted": "󰂰 Muted",
		"format-headphones": "󰋋 {volume}%",
		"format-headphones-muted": "󰋋 Muted",
		"tooltip-format": "{desc} {volume}%",
		"on-click": "pavucontrol",
		"on-click-middle": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
		"on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
		"on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
		"scroll-step": 5,
		"format-icons": {
			"headphone": "󰋋",
			"hands-free": "",
			"headset": "󰋎",
			"phone": "",
			"portable": "",
			"car": "",
			"default": ["󰋋", "󰋋", "󰋋"]
		}
	},

	"custom/nightmode": {
		"format": "󰌵 ",
		"on-click": "bash -c 'if pgrep gammastep > /dev/null; then pkill gammastep; else gammastep -O 3500; fi'"
	},

	"network": {
    		"format-wifi": " {essid}",
    		"format-ethernet": " 󰈁󰈀 ",
    		"format-linked": " {ifname} (No IP)",
    		"format-disconnected": "󰈂 󰈀 Disconnected",
    		"format-alt": "{ipaddr}/{cidr}",
    		"tooltip-format": "
        		<b>{ifname}</b>
        		<tt>────────────────────</tt>
        		<b>IP:</b> {ipaddr}
       			<b>CIDR:</b> {cidr}
        		<b>MAC:</b> {mac}
        		<b>Signal:</b> {signalStrength}%
        		<b>Frequency:</b> {frequency}MHz
    		"
	}
}
