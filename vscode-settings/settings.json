{
    "editor.fontSize": 14,
    "editor.fontFamily": "Iosevka Nerd Font Mono",
    "editor.fontLigatures": true,
    "editor.autoClosingBrackets": "languageDefined",
    "[c]": {
        "editor.autoClosingBrackets": "always",
        "editor.tabSize": 8
    },
    "[cpp]": {
        "editor.autoClosingBrackets": "always",
        "editor.tabSize": 8
    },
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autoclosingBrackets": true,
    
    "workbench.statusBar.visible": false,
    "workbench.editor.showTabs": "single",
    "workbench.editor.decorations.badges": false,
    "workbench.startupEditor": "none",
    "window.zoomLevel": 0,
    "editor.detectIndentation": false,
    "editor.minimap.enabled": false,
    "editor.scrollbar.horizontal": "hidden",
    "editor.scrollbar.vertical": "hidden",
    "editor.hideCursorInOverviewRuler": true,
    "editor.overviewRulerBorder": false,
    "editor.lineNumbers": "on",
    "editor.glyphMargin": false,
    "editor.folding": false,
    "editor.renderLineHighlight": "none",
    "editor.matchBrackets": "never",
    "breadcrumbs.enabled": false,
    "editor.renderControlCharacters": false,
    "editor.renderWhitespace": "none",
    "editor.smoothScrolling": true,
    "editor.centeredLayout": true,
    "editor.stickyScroll.enabled": false,
    "zenMode.fullScreen": false,
    "zenMode.hideActivityBar": true,
    "zenMode.hideStatusBar": true,
    "zenMode.restore": true,
    "workbench.activityBar.location": "hidden",
    "zenMode.showTabs": "single",
    "window.commandCenter": false,
    "workbench.layoutControl.enabled": false,
    "chat.commandCenter.enabled": false,
    "workbench.sideBar.location": "right",
    "explorer.compactFolders": false,
    "explorer.decorations.badges": false,
    "explorer.sortOrder": "type",
    "editor.inlayHints.enabled": "off",
    "C_Cpp.inlayHints.autoDeclaration.enabled": false,
    "C_Cpp.inlayHints.parameterNames.enabled": false,
    "C_Cpp.inlayHints.referenceOperator.enabled": false,
    "C_Cpp.inlayHints.variableTypes.enabled": false,
    "editor.cursorStyle": "line",
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorWidth": 2,
    "editor.focusOutline": false,
    "workbench.list.focusOutline": false,
    "editor.accessibilitySupport": "off",
    "window.autoDetectHighContrast": false,
    "window.menuBarVisibility": "hidden",
    "window.customTitleBarVisibility": "never",
    "window.titleBarStyle": "native",
    "workbench.iconTheme": "catppuccin noctis icons",
    "editor.tabSize": 4,
    "editor.guides.indentation": true,
    "workbench.colorTheme": "Dark Purple",
    "catppuccin-noctis-icons.hidesExplorerArrows": false,
    "explorer.confirmDragAndDrop": false,

        "editor.suggestOnTriggerCharacters": true,
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.acceptSuggestionOnEnter": "on",
    "editor.suggestWidget.visible": true
}
